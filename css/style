/*
   style.css — External stylesheet (shared across every page)
   Design concept: the site chrome looks like a code editor.
   
/* Design tokens */
:root {
  /* Layered dark surface, like an editor's panes */
  --bg: #0b0e14;
  --bg-elev: #131826;
  --bg-elev-2: #1a2032;
  --border: #262c3d;

  /* Text */
  --text: #e7eaf2;
  --text-dim: #9aa3b8;
  --text-muted: #6b7386;

  /* Syntax-inspired accents */
  --accent: #f0a35c;     
  --accent-2: #6ee7b0;    
  --accent-3: #7dd3fc;    
  --danger: #f87171;     

  --radius: 8px;
  --font-display: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;

  --max-width: 1080px;
}

/* Light theme override dark (above) is the default/fallback palette.
   Toggled via js/theme.js, which sets data-theme="light" on <html>/<body>. */
[data-theme="light"] {
  --bg: #f6f7fb;
  --bg-elev: #ffffff;
  --bg-elev-2: #eceef4;
  --border: #dde1ea;

  --text: #12151c;
  --text-dim: #444b5c;
  --text-muted: #767d90;
}

/* Theme toggle button, lives inside the shared nav (components/header.html) */
.theme-toggle-btn {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  background: transparent;
  border: none;
  border-left: 1px solid var(--border);
  color: var(--text-muted);
  padding: 0 3.3rem ;
  cursor: pointer;
  white-space: nowrap;
}
.theme-toggle-btn:hover { color: var(--accent-3); background: var(--bg-elev-2); }

/* Reset */
* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }

a { color: inherit; text-decoration: none; }

ul, ol { list-style: none; }

button, input, textarea, select { font: inherit; color: inherit; }

:focus-visible {
  outline: 2px solid var(--accent-3);
  outline-offset: 3px;
}

.wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* Typography */
h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

h1 { font-size: clamp(2rem, 4vw, 3rem); }
h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 1rem; }
h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }

p { color: var(--text-dim); }

.eyebrow {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-3);
  margin-bottom: 0.75rem;
}

.eyebrow::before { content: '// '; color: var(--text-muted); }

/* Site header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--bg-elev);
  border-bottom: 1px solid var(--border);
}

.editor-titlebar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
}

.dots { display: flex; gap: 0.4rem; margin-right: 0.5rem; }
.dots span {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--bg-elev-2);
  border: 1px solid var(--border);
}
.dots span:nth-child(1) { background: #f87171; border-color: #f87171; }
.dots span:nth-child(2) { background: #f0a35c; border-color: #f0a35c; }
.dots span:nth-child(3) { background: #6ee7b0; border-color: #6ee7b0; }

.navbar {
  display: flex;
  align-items: stretch;
  max-width: var(--max-width);
  margin: 0 auto;
  overflow-x: auto;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0 1.25rem;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1rem;
  color: var(--text);
  white-space: nowrap;
}

.brand .cursor {
  display: inline-block;
  width: 2px;
  height: 1em;
  background: var(--accent);
  animation: blink 1.1s steps(1) infinite;
}

@keyframes blink { 50% { opacity: 0; } }

.nav-tabs {
  display: flex;
  flex: 1;
  list-style: none;
}

.nav-tabs a {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.9rem 1.1rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-muted);
  border-right: 1px solid var(--border);
  border-top: 2px solid transparent;
  white-space: nowrap;
  transition: color 0.15s ease, background 0.15s ease;
}

.nav-tabs a:hover {
  color: var(--text);
  background: var(--bg-elev-2);
}

.nav-tabs a[aria-current="page"] {
  color: var(--accent);
  background: var(--bg);
  border-top-color: var(--accent);
}

.nav-tabs .tab-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: currentColor; opacity: 0.6;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1.3rem;
  border-radius: var(--radius);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 500;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease;
}

.btn-primary {
  background: var(--accent);
  color: #0b0e14;
  border-color: var(--accent);
}
.btn-primary:hover { transform: translateY(-2px); }

.btn-ghost {
  background: transparent;
  color: var(--text);
}
.btn-ghost:hover { border-color: var(--accent-3); color: var(--accent-3); }

/* Hero */
.hero {
  padding: 5rem 0 4rem;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.terminal {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 20px 60px -20px rgba(0,0,0,0.6);
}

.terminal-bar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.9rem;
  background: var(--bg-elev-2);
  border-bottom: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
}

.terminal-body {
  padding: 1.25rem 1.4rem 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.9rem;
  line-height: 1.9;
}

.terminal-body .ln { color: var(--text-muted); display: inline-block; width: 1.5rem; user-select: none; }
.tok-key { color: var(--accent); }
.tok-str { color: var(--accent-2); }
.tok-fn  { color: var(--accent-3); }
.tok-com { color: var(--text-muted); font-style: italic; }
.tok-punc { color: var(--text-dim); }

/* Cards */
.card {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  transition: border-color 0.15s ease, transform 0.15s ease;
}
.card:hover { border-color: var(--accent-3); transform: translateY(-3px); }

.grid {
  display: grid;
  gap: 1.5rem;
}
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }

.tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  color: var(--text-dim);
  margin: 0 0.35rem 0.35rem 0;
}

.section { padding: 4rem 0; }
.section-alt { background: var(--bg-elev); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

/* Forms */
.field { margin-bottom: 1.25rem; }
.field label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text-dim);
  margin-bottom: 0.4rem;
}
.field input,
.field textarea,
.field select {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.75rem 0.9rem;
  color: var(--text);
}
.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: var(--accent-3);
}
.field textarea { resize: vertical; min-height: 140px; }

.error-msg {
  display: block;
  color: var(--danger);
  font-size: 0.78rem;
  font-family: var(--font-mono);
  margin-top: 0.35rem;
  min-height: 1em;
}

/* Footer */
.site-footer {
  background: var(--bg-elev);
  border-top: 1px solid var(--border);
  padding: 2rem 0;
  margin-top: 3rem;
}

.footer-inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}

.prompt {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-muted);
}
.prompt .path { color: var(--accent-2); }
.prompt .sign { color: var(--accent); }

.social-links {
  display: flex;
  gap: 0.9rem;
}
.social-links a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px; height: 36px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-dim);
  transition: color 0.15s ease, border-color 0.15s ease;
}
.social-links a:hover { color: var(--accent-3); border-color: var(--accent-3); }
.social-links svg { width: 18px; height: 18px; }

/* Utility */
.avatar {
  width: 128px; height: 128px;
  border-radius: var(--radius);
  background: linear-gradient(150deg, var(--accent), var(--accent-3));
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 2.2rem;
  color: #0b0e14;
  object-fit: cover; 
}

.list-check li, .list-plain li {
  padding: 0.4rem 0;
  color: var(--text-dim);
  border-bottom: 1px dashed var(--border);
}
.list-check li::before { content: '✓ '; color: var(--accent-2); font-family: var(--font-mono); }

.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }

.badge-latest {
  display: inline-block;
  background: var(--accent);
  color: #0b0e14;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  margin-left: 0.5rem;
  vertical-align: middle;
}

/* Responsive */
@media (max-width: 860px) {
  .hero-grid, .two-col { grid-template-columns: 1fr; }
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
  .nav-tabs a span.label { display: none; }
}

@media (max-width: 560px) {
  .brand { padding: 0 0.9rem; }
  .terminal-body { font-size: 0.8rem; }
}

